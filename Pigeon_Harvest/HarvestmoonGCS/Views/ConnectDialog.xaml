<ContentDialog
    x:Class="HarvestmoonGCS.Views.ConnectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    BorderThickness="0"
    CornerRadius="16"
    x:Name="RootDialog">

    <ContentDialog.Resources>
        <LinearGradientBrush x:Key="IdleHeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2563EB" Offset="0"/>
            <GradientStop Color="#9333EA" Offset="1"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="ConnectingHeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#22D3EE" Offset="0.5"/>
            <GradientStop Color="#3B82F6" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource MutedForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveTabButtonStyle" TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource PrimaryBrush20}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}"/>
        </Style>
    </ContentDialog.Resources>

    <Grid Background="{ThemeResource CardBrush}" 
          BorderBrush="{ThemeResource BorderBrush}" 
          BorderThickness="1"
          CornerRadius="16"
          Width="448"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header accent line -->
        <Rectangle x:Name="HeaderAccentLine" 
                   Height="4" 
                   Grid.Row="0" 
                   Fill="{StaticResource IdleHeaderGradient}" 
                   HorizontalAlignment="Stretch"/>

        <Grid Grid.Row="1" Padding="24">
            <StackPanel Spacing="24">
                <!-- Title Section -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border x:Name="TitleIconBorder"
                            Width="36" Height="36" 
                            CornerRadius="10" 
                            Background="{ThemeResource PrimaryBrush20}" 
                            BorderBrush="{ThemeResource PrimaryBrush}" 
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <FontIcon x:Name="TitleIcon" 
                                  Glyph="{StaticResource IconPlug}" 
                                  FontSize="18" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource PrimaryBrush}"/>
                    </Border>
                    
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MAVLink Connection" 
                                   FontWeight="Bold" 
                                   FontSize="16"
                                   Foreground="{ThemeResource ForegroundBrush}"/>
                        <TextBlock x:Name="StatusSubtitle" 
                                   Text="Configure &amp; connect to your UAV" 
                                   FontSize="12" 
                                   Foreground="{ThemeResource MutedForegroundBrush}"/>
                    </StackPanel>
                    
                    <Button Grid.Column="2" 
                            FontSize="14"
                            Padding="0"
                            Width="32" Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{ThemeResource MutedForegroundBrush}"
                            Click="CancelButton_Click">
                        <FontIcon Glyph="{StaticResource IconClose}" FontSize="12"/>
                    </Button>
                </Grid>

                <!-- Connection Type Tabs -->
                <!-- Connecting progress -->
                <StackPanel x:Name="ConnectingProgressPanel" Spacing="8" Visibility="Collapsed">
                    <ProgressBar x:Name="ConnectProgressBar" 
                                 Height="4" 
                                 Minimum="0" Maximum="100" Value="0"
                                 Foreground="{ThemeResource PrimaryBrush}"
                                 Background="{ThemeResource MutedBrush}"/>
                    <Grid>
                        <TextBlock Text="Establishing link..." FontSize="10" Foreground="{ThemeResource MutedForegroundBrush}"/>
                        <TextBlock x:Name="ProgressPercentage" Text="0%" FontSize="10" HorizontalAlignment="Right" Foreground="{ThemeResource MutedForegroundBrush}"/>
                    </Grid>
                </StackPanel>

                <!-- Tab baris 1: UDP | TCP | Serial -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button x:Name="UdpTab" Grid.Column="0" Style="{StaticResource ActiveTabButtonStyle}" Click="TypeTab_Click" Tag="UDP">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="{StaticResource IconSatellite}" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="UDP" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button x:Name="TcpTab" Grid.Column="1" Style="{StaticResource TabButtonStyle}" Click="TypeTab_Click" Tag="TCP">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="{StaticResource IconNavigation}" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="TCP" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button x:Name="SerialTab" Grid.Column="2" Style="{StaticResource TabButtonStyle}" Click="TypeTab_Click" Tag="Serial">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="{StaticResource IconPlug}" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="SERIAL" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Tab baris 2: RunCam WiFi Link & LoRa Soil Sensor -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button x:Name="RuncamTab" 
                            Grid.Column="0"
                            Style="{StaticResource TabButtonStyle}" 
                            Click="TypeTab_Click" 
                            Tag="RuncamWifi">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE714;" FontSize="13" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SIYI HM30" FontSize="9.5" FontWeight="Bold"/>
                                <TextBlock Text="Kamera HD + MAVLink" FontSize="8" Foreground="{ThemeResource MutedForegroundBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="LoraTab" 
                            Grid.Column="1"
                            Style="{StaticResource TabButtonStyle}" 
                            Click="TypeTab_Click" 
                            Tag="LoRaSoil">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE701;" FontSize="13" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="LORA SENSOR" FontSize="9.5" FontWeight="Bold"/>
                                <TextBlock Text="Ground Truth IoT" FontSize="8" Foreground="{ThemeResource MutedForegroundBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Form Fields -->
                <StackPanel x:Name="FormFieldsStack" Spacing="16">
                    <!-- Host/IP Section (Visible for UDP/TCP) -->
                    <StackPanel x:Name="NetworkFields" Spacing="8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="HOST / IP ADDRESS" 
                                       FontSize="10" 
                                       FontWeight="Bold" 
                                       Foreground="{ThemeResource MutedForegroundBrush}"/>
                            <TextBox x:Name="HostTextBox" 
                                     Text="0.0.0.0" 
                                     PlaceholderText="0.0.0.0 (Dengarkan UAV / Orange Pi)"
                                     Background="{ThemeResource BackgroundBrush}"
                                     BorderBrush="{ThemeResource BorderBrush}"
                                     FontSize="14"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="4">
                            <TextBlock Text="PORT" 
                                       FontSize="10" 
                                       FontWeight="Bold" 
                                       Foreground="{ThemeResource MutedForegroundBrush}"/>
                            <TextBox x:Name="PortTextBox" 
                                     Text="14550" 
                                     PlaceholderText="14550"
                                     Background="{ThemeResource BackgroundBrush}"
                                     BorderBrush="{ThemeResource BorderBrush}"
                                     FontSize="14"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Serial Section (Visible for Serial) -->
                    <StackPanel x:Name="SerialFields" Spacing="8" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SERIAL PORT" 
                                           FontSize="10" 
                                           FontWeight="Bold" 
                                           Foreground="{ThemeResource MutedForegroundBrush}"/>
                                <Button Grid.Column="1"
                                        x:Name="RefreshPortsButton"
                                        Content="Refresh"
                                        FontSize="10"
                                        Padding="6,2"
                                        Margin="8,0,0,0"
                                        CornerRadius="6"
                                        Background="{ThemeResource MutedBrush}"
                                        Foreground="{ThemeResource MutedForegroundBrush}"
                                        BorderThickness="0"
                                        Click="RefreshPortsButton_Click" />
                            </Grid>
                            <ComboBox x:Name="SerialPortComboBox" 
                                      HorizontalAlignment="Stretch"
                                      Background="{ThemeResource BackgroundBrush}"
                                      BorderBrush="{ThemeResource BorderBrush}"
                                      FontSize="14"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="4">
                            <TextBlock Text="BAUD RATE" 
                                       FontSize="10" 
                                       FontWeight="Bold" 
                                       Foreground="{ThemeResource MutedForegroundBrush}"/>
                            <ComboBox x:Name="BaudRateComboBox" 
                                      HorizontalAlignment="Stretch"
                                      Background="{ThemeResource BackgroundBrush}"
                                      BorderBrush="{ThemeResource BorderBrush}"
                                      FontSize="14"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True">
                                <x:Int32>9600</x:Int32>
                                <x:Int32>19200</x:Int32>
                                <x:Int32>38400</x:Int32>
                                <x:Int32>57600</x:Int32>
                                <x:Int32>115200</x:Int32>
                                <x:Int32>230400</x:Int32>
                                <x:Int32>460800</x:Int32>
                                <x:Int32>921600</x:Int32>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- ══════════════════════════════════════════════════
                         RunCam WiFi Link 2 Fields
                         Tampil saat tab RuncamWifi aktif
                         ══════════════════════════════════════════════════ -->
                    <StackPanel x:Name="RuncamWifiFields" Spacing="12" Visibility="Collapsed">

                        <!-- Status bar auto-detect -->
                        <Border x:Name="RuncamStatusBorder"
                                CornerRadius="8"
                                Padding="10,8"
                                Background="{ThemeResource MutedBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="RuncamStatusText"
                                           Text="Belum terdeteksi – scan jaringan atau isi manual"
                                           FontSize="11"
                                           Foreground="{ThemeResource MutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        x:Name="RuncamScanButton"
                                        Content="Scan"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Padding="10,4"
                                        Margin="8,0,0,0"
                                        CornerRadius="6"
                                        Background="{ThemeResource PrimaryBrush20}"
                                        BorderBrush="{ThemeResource PrimaryBrush}"
                                        BorderThickness="1"
                                        Foreground="{ThemeResource PrimaryBrush}"
                                        Click="RuncamScanButton_Click"/>
                            </Grid>
                        </Border>

                        <!-- IP Kamera -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="IP KAMERA SIYI / AIR UNIT (default: 192.168.144.25)"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{ThemeResource MutedForegroundBrush}"/>
                            <TextBox x:Name="RuncamIpTextBox"
                                     Text="192.168.144.25"
                                     PlaceholderText="192.168.144.25 (Kamera SIYI) / 192.168.144.11 (Ground Unit)"
                                     Background="{ThemeResource BackgroundBrush}"
                                     BorderBrush="{ThemeResource BorderBrush}"
                                     FontSize="14"/>
                        </StackPanel>

                        <!-- Stream Protocol -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="PROTOKOL STREAM VIDEO HD"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{ThemeResource MutedForegroundBrush}"/>
                            <ComboBox x:Name="RuncamProtocolComboBox"
                                      HorizontalAlignment="Stretch"
                                      Background="{ThemeResource BackgroundBrush}"
                                      BorderBrush="{ThemeResource BorderBrush}"
                                      FontSize="13"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="RTSP (rtsp://192.168.144.25:8554/main.264)" Tag="Rtsp"/>
                                <ComboBoxItem Content="RTSP Sub-Stream (rtsp://192.168.144.25:8554/live/ch0)" Tag="RtspSub"/>
                                <ComboBoxItem Content="MJPEG (http://192.168.144.25:8080/video_feed)" Tag="Mjpeg"/>
                                <ComboBoxItem Content="Auto Detect Stream" Tag="Auto"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- MAVLink Port -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="MAVLINK PORT LOKAL GCS"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{ThemeResource MutedForegroundBrush}"/>
                                <TextBox x:Name="RuncamMavLocalPortTextBox"
                                         Text="14550"
                                         Background="{ThemeResource BackgroundBrush}"
                                         BorderBrush="{ThemeResource BorderBrush}"
                                         FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="MAVLINK PORT REMOTE (HM30)"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{ThemeResource MutedForegroundBrush}"/>
                                <TextBox x:Name="RuncamMavRemotePortTextBox"
                                         Text="14550"
                                         Background="{ThemeResource BackgroundBrush}"
                                         BorderBrush="{ThemeResource BorderBrush}"
                                         FontSize="14"/>
                            </StackPanel>
                        </Grid>

                        <!-- Koneksi otomatis: kamera + MAVLink bersamaan -->
                        <TextBlock FontSize="11"
                                   Foreground="{ThemeResource MutedForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Text="Otomatis: stream kamera Full HD (RTSP 8554) dan MAVLink UDP 14550 terhubung bersamaan dalam 1 kali Connect."/>

                        <!-- Info box -->
                        <Border CornerRadius="8" Padding="10,8"
                                Background="#1A8B5CF6"
                                BorderBrush="#3B8B5CF6"
                                BorderThickness="1">
                            <TextBlock FontSize="11"
                                       Foreground="{ThemeResource MutedForegroundBrush}"
                                       TextWrapping="Wrap">
                                <Run FontWeight="Bold">SIYI HM30 HD Digital Link:</Run>
                                <Run> Hubungkan port LAN Ground Unit ke laptop. Atur IP adapter LAN laptop ke </Run>
                                <Run FontWeight="Bold">192.168.144.20</Run>
                                <Run> (Gateway: 192.168.144.11). Klik Connect untuk mengaktifkan video RTSP &amp; telemetri Pixhawk bersamaan.</Run>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- ══════════════════════════════════════════════════
                         LoRa Soil Sensor Fields (Ground Truth)
                         ══════════════════════════════════════════════════ -->
                    <StackPanel x:Name="LoraSoilFields" Spacing="10" Visibility="Collapsed">
                        <Border CornerRadius="8" Padding="10,8" Background="#1A10B981" BorderBrush="#3B10B981" BorderThickness="1">
                            <StackPanel Spacing="3">
                                <TextBlock Text="SISTEM PENERIMA LORA GROUND-TRUTH (4 NODE PDP)" FontSize="10.5" FontWeight="Bold" Foreground="#10B981"/>
                                <TextBlock Text="Menerima data telemetri kelembaban tanah (VWC %), suhu, voltase &amp; RSSI dari node P-01 s.d. P-04 di petak sawah." FontSize="9.5" Foreground="{ThemeResource MutedForegroundBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="4">
                            <TextBlock Text="SUMBER INPUT LORA" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource MutedForegroundBrush}"/>
                            <ComboBox x:Name="LoraSourceComboBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="Serial USB / UART (Dongle LoRa)" Tag="Serial"/>
                                <ComboBoxItem Content="UDP Socket Port 14552 (Companion/WiFi Gateway)" Tag="UDP"/>
                                <ComboBoxItem Content="Simulasi Multi-Node PDP (P-01..P-04)" Tag="Sim"/>
                            </ComboBox>
                        </StackPanel>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="PORT LORA (SERIAL / UDP)" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource MutedForegroundBrush}"/>
                                <TextBox x:Name="LoraPortTextBox" Text="/dev/ttyUSB0" Background="{ThemeResource BackgroundBrush}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="BAUD RATE" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource MutedForegroundBrush}"/>
                                <ComboBox x:Name="LoraBaudComboBox" HorizontalAlignment="Stretch" SelectedIndex="1">
                                    <x:Int32>9600</x:Int32>
                                    <x:Int32>115200</x:Int32>
                                    <x:Int32>57600</x:Int32>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="BtnTriggerLoraAutoCheck" Content="⚡ Jalankan Pengecekan Otomatis (Auto-Check)" HorizontalAlignment="Stretch" FontSize="11" FontWeight="SemiBold" CornerRadius="8" Background="{ThemeResource PrimaryBrush20}" BorderBrush="{ThemeResource PrimaryBrush}" BorderThickness="1" Foreground="{ThemeResource PrimaryBrush}" Click="BtnTriggerLoraAutoCheck_Click"/>

                        <!-- Hasil evaluasi otomatis ringkas -->
                        <Border x:Name="LoraAutoCheckStatusBorder" CornerRadius="8" Padding="10,8" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="3">
                                <TextBlock x:Name="LoraAutoCheckTitle" Text="Status Pengecekan: Siap Diverifikasi" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource ForegroundBrush}"/>
                                <TextBlock x:Name="LoraAutoCheckDesc" Text="Tekan 'Connect' atau 'Auto-Check' untuk memverifikasi 4 probe in-situ." FontSize="9.5" Foreground="{ThemeResource MutedForegroundBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Quick Presets (sembunyikan saat tab RunCam aktif) -->
                <StackPanel x:Name="PresetsPanel" Spacing="8">
                    <TextBlock Text="QUICK PRESETS" 
                               FontSize="10" 
                               FontWeight="Bold" 
                               Foreground="{ThemeResource MutedForegroundBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="SITL" FontSize="10" FontWeight="Bold" Padding="10,4" CornerRadius="6" Background="{ThemeResource MutedBrush}" Foreground="{ThemeResource MutedForegroundBrush}" BorderThickness="0" Click="Preset_Click" Tag="SITL"/>
                        <Button Content="UAV LISTEN" FontSize="10" FontWeight="Bold" Padding="10,4" CornerRadius="6" Background="#1A2563EB" BorderBrush="#3B2563EB" BorderThickness="1" Foreground="#60A5FA" Click="Preset_Click" Tag="UAVLISTEN"/>
                        <Button Content="GCS RELAY" FontSize="10" FontWeight="Bold" Padding="10,4" CornerRadius="6" Background="{ThemeResource MutedBrush}" Foreground="{ThemeResource MutedForegroundBrush}" BorderThickness="0" Click="Preset_Click" Tag="GCS"/>
                        <Button Content="TELEMETRY" FontSize="10" FontWeight="Bold" Padding="10,4" CornerRadius="6" Background="{ThemeResource MutedBrush}" Foreground="{ThemeResource MutedForegroundBrush}" BorderThickness="0" Click="Preset_Click" Tag="TELEMETRY"/>
                        <Button Content="HM30" FontSize="10" FontWeight="Bold" Padding="10,4" CornerRadius="6" Background="#1A8B5CF6" BorderBrush="#3B8B5CF6" BorderThickness="1" Foreground="#A78BFA" Click="Preset_Click" Tag="HM30"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button x:Name="CancelButton" 
                            Grid.Column="0" 
                            HorizontalAlignment="Stretch"
                            Padding="16,10"
                            CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource BorderBrush}"
                            Background="Transparent"
                            Foreground="{ThemeResource MutedForegroundBrush}"
                            Click="CancelButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="{StaticResource IconClose}" FontSize="14"/>
                            <TextBlock Text="Cancel" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                            
                    <Button x:Name="ConnectButton" 
                            Grid.Column="1" 
                            HorizontalAlignment="Stretch"
                            Padding="16,10"
                            CornerRadius="12"
                            Background="{ThemeResource PrimaryBrush}"
                            Foreground="{ThemeResource PrimaryForegroundBrush}"
                            Click="ConnectButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <TextBlock x:Name="ConnectButtonText" Text="Connect" FontWeight="SemiBold"/>
                            <FontIcon x:Name="ConnectButtonIcon" Glyph="{StaticResource IconPlug}" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</ContentDialog>
