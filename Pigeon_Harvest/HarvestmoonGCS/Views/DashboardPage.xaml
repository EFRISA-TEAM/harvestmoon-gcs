<Page
    x:Class="HarvestmoonGCS.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:HarvestmoonGCS.Controls"
    mc:Ignorable="d"
    Background="#F5FBF6">

    <Page.Resources>
        <!-- Card container (matching ui harvest Card: rounded-2xl border border-emerald-100) -->
        <Style x:Key="HarvestCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1E7D5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>

        <!-- Card header bar -->
        <Style x:Key="HarvestCardHeaderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#E5F3E8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>

        <!-- Pill styles per tone -->
        <Style x:Key="PillSuccessStyle" TargetType="Border">
            <Setter Property="Background" Value="#ECFDF5"/>
            <Setter Property="BorderBrush" Value="#A7F3D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,3"/>
        </Style>
        <Style x:Key="PillInfoStyle" TargetType="Border">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="BorderBrush" Value="#BFDBFE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,3"/>
        </Style>
        <Style x:Key="PillCriticalStyle" TargetType="Border">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,3"/>
        </Style>
        <Style x:Key="PillWarningStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFBEB"/>
            <Setter Property="BorderBrush" Value="#FDE68A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,3"/>
        </Style>

        <!-- HUD pill (dark) for video overlay -->
        <Style x:Key="HudPillStyle" TargetType="Border">
            <Setter Property="Background" Value="#8C000000"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>

        <!-- Outline button -->
        <Style x:Key="HarvestOutlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#166534"/>
            <Setter Property="BorderBrush" Value="#A7F3D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Primary button -->
        <Style x:Key="HarvestPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Secondary button -->
        <Style x:Key="HarvestSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Hud action button -->
        <Style x:Key="HudActionButton" TargetType="Button">
            <Setter Property="Background" Value="#8C000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="16,14,16,20" ColumnSpacing="12" RowSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- ================ LEFT COLUMN ================ -->
            <StackPanel Grid.Column="0" Spacing="12">

                <!-- === Live Monitoring Card === -->
                <Border Style="{StaticResource HarvestCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Style="{StaticResource HarvestCardHeaderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT: Title + Status Telemetry Badges -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8F4;" FontSize="14" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                    <TextBlock Text="Live Monitoring · YOLO Crop Detection"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#0F3024" VerticalAlignment="Center"/>

                                    <!-- Mode Badge -->
                                    <Border x:Name="ModeBadge" CornerRadius="6" Padding="7,3" Background="#1D4ED8" VerticalAlignment="Center">
                                        <TextBlock x:Name="ModeText" Text="STANDBY" FontSize="10"
                                                   Foreground="White" FontWeight="Bold"/>
                                    </Border>

                                    <!-- AI Status Pill -->
                                    <Border x:Name="AiStatusPill" Style="{StaticResource PillSuccessStyle}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="AiStatusText" Text="AI ON" FontSize="10" Foreground="#065F46" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Detections Count Pill -->
                                    <Border Style="{StaticResource PillInfoStyle}" VerticalAlignment="Center">
                                        <TextBlock x:Name="DetectionCountText" Text="0 det" FontSize="10" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- Live Via Connect Pill -->
                                    <Border x:Name="LiveViaConnectionPill" CornerRadius="6" Padding="6,3" Background="Transparent" BorderBrush="#1565C0" BorderThickness="1"
                                            VerticalAlignment="Center" Visibility="Collapsed"
                                            ToolTipService.ToolTip="Live detection stream aktif otomatis saat UAV terhubung via Connect">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE714;" FontSize="10" Foreground="#1565C0"/>
                                            <TextBlock x:Name="LiveViaConnectionText" Text="Live via Connect" FontSize="10" Foreground="#1565C0" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- RIGHT: Demo Scenario & Video Controls Toolbar Capsule -->
                                <Border Grid.Column="1" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <!-- Scenario Selector Dropdown -->
                                        <ComboBox x:Name="DemoScenarioComboBox"
                                                  SelectedIndex="0"
                                                  FontSize="11"
                                                  Height="30"
                                                  Padding="8,0"
                                                  MinWidth="175"
                                                  MaxWidth="220"
                                                  Background="White"
                                                  BorderBrush="#CBD5E1"
                                                  BorderThickness="1"
                                                  CornerRadius="6"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="DemoScenarioComboBox_SelectionChanged"
                                                  ToolTipService.ToolTip="Pilih Skenario Video &amp; Misi Demo TEKNOFEST">
                                            <ComboBoxItem Content="★ Multi-Sektor Riset PDP (Subang · 14 WP)"/>
                                            <ComboBoxItem Content="Sawah 15 HST (Karawang · 4 WP)"/>
                                            <ComboBoxItem Content="Lahan Irigasi (Majalengka · 5 WP)"/>
                                            <ComboBoxItem Content="Lahan Kering (Bogor · 4 WP)"/>
                                            <ComboBoxItem x:Name="CustomVideoComboItem" Content="📁 Pilih Video Kustom..."/>
                                        </ComboBox>

                                        <!-- Custom Video Button — disembunyikan (drag & drop tetap aktif) -->
                                        <Button x:Name="ChangeVideoButton" 
                                                Height="30" 
                                                Padding="8,0"
                                                Background="White"
                                                BorderBrush="#CBD5E1"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed"
                                                Click="ChangeVideoButton_Click" 
                                                ToolTipService.ToolTip="Buka File Video Kustom dari Disk (Drag &amp; Drop atau Browse)">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE8E5;" FontSize="11" Foreground="#0284C7"/>
                                                <TextBlock Text="Pilih File" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Start / Stop Demo Action Button -->
                                        <Button x:Name="StartDemoButton" 
                                                Height="30"
                                                Padding="12,0"
                                                Background="#2E7D32" 
                                                BorderThickness="0"
                                                CornerRadius="6"
                                                VerticalAlignment="Center"
                                                Click="StartDemoButton_Click"
                                                ToolTipService.ToolTip="Mulai / Hentikan Simulasi Demo TEKNOFEST">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="White"/>
                                                <TextBlock Text="Start Demo" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Body -->
                        <Grid Grid.Row="1" Padding="8,8,8,6" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <!-- === Live Video with overlays === -->
                            <Border Grid.Column="0" CornerRadius="10" Background="#000000" BorderBrush="#1E293B" BorderThickness="1">
                                <Grid Height="260" x:Name="VideoRoot"
                                      AllowDrop="True"
                                      DragOver="VideoRoot_DragOver"
                                      DragLeave="VideoRoot_DragLeave"
                                      Drop="VideoRoot_Drop">
                                    <!-- Actual live video (YOLO overlays drawn by VideoStreamControl) -->
                                    <controls:VideoStreamControl x:Name="DashboardVideoStream"/>

                                    <!-- Vegetation overlay (color wash) - collapsed so video is crisp and not dimmed/obscured -->
                                    <Rectangle x:Name="VegetationOverlayLayer" Visibility="Collapsed" Opacity="0.32" IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#8C2E7D32" Offset="0"/>
                                                <GradientStop Color="#55FBC02D" Offset="0.55"/>
                                                <GradientStop Color="#66D32F2F" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>

                                    <!-- Grid overlay -->
                                    <Canvas x:Name="GridOverlayCanvas" IsHitTestVisible="False" Opacity="0.3" Visibility="Collapsed"/>

                                    <!-- Heatmap overlay (radial gradients) -->
                                    <Grid x:Name="HeatmapOverlayLayer" Visibility="Collapsed" IsHitTestVisible="False">
                                        <Ellipse Width="260" Height="260" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="120,60,0,0" Opacity="0.45">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#FFFF0000" Offset="0"/>
                                                    <GradientStop Color="#00FF0000" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse Width="220" Height="220" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,40,140,0" Opacity="0.45">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#FFFFB400" Offset="0"/>
                                                    <GradientStop Color="#00FFB400" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>

                                    <!-- Top HUD bar -->
                                    <Grid VerticalAlignment="Top" Margin="12" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                            <Border Style="{StaticResource HudPillStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Fill="#EF4444" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="RecStatusText" Text="REC" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource HudPillStyle}">
                                                <TextBlock x:Name="FpsHudText" Text="YOLO11n · standby" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Style="{StaticResource HudPillStyle}">
                                                <TextBlock x:Name="ConfAvgText" Text="Conf avg 0%" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource HudPillStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE707;" FontSize="11" Foreground="White"/>
                                                <TextBlock x:Name="GpsHudText" Text="-6.91124, 107.61152" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>


                                    <!-- Bottom HUD bar -->
                                    <Grid VerticalAlignment="Bottom" Margin="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <Border Style="{StaticResource HudPillStyle}" HorizontalAlignment="Left">
                                                <TextBlock x:Name="AltSpdHudText" Text="ALT 0 m · SPD 0 m/s" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Style="{StaticResource HudPillStyle}" HorizontalAlignment="Left">
                                                <TextBlock x:Name="HdgModeText" Text="HDG 0° · MODE STANDBY" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Visibility="Collapsed">
                                            <Button x:Name="RecordButton" Style="{StaticResource HudActionButton}" Click="RecordButton_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon x:Name="RecordIcon" Glyph="&#xE71A;" FontSize="12"/>
                                                    <TextBlock x:Name="RecordLabel" Text="Stop"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource HudActionButton}" Click="SnapshotButton_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE722;" FontSize="12"/>
                                                    <TextBlock Text="Snapshot"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource HudActionButton}" Click="PauseAiButton_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon x:Name="PauseAiIcon" Glyph="&#xE769;" FontSize="12"/>
                                                    <TextBlock x:Name="PauseAiLabel" Text="Pause AI"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- IMU Tactical Avionics HUD (top-right overlay on live video) - Collapsed by default so it never obscures detection labels -->
                                    <StackPanel x:Name="ImuHudPanel" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Spacing="3">
                                        <Border Width="82" Height="82" CornerRadius="41" Background="#DD0B1329" BorderBrush="#8038BDF8" BorderThickness="1.5">
                                            <Grid Width="82" Height="82">
                                                <!-- Circular Mask for Horizon Sphere -->
                                                <Grid.Clip>
                                                    <RectangleGeometry Rect="0,0,82,82"/>
                                                </Grid.Clip>

                                                <!-- Rotating Pitch & Roll Horizon Sphere -->
                                                <Grid x:Name="ImuRotationGrid" Width="82" Height="82" RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <RotateTransform x:Name="ImuRollTransform" Angle="0"/>
                                                    </Grid.RenderTransform>

                                                    <Grid x:Name="ImuPitchGrid" Height="180" VerticalAlignment="Center">
                                                        <Grid.RenderTransform>
                                                            <TranslateTransform x:Name="ImuPitchTransform" Y="0"/>
                                                        </Grid.RenderTransform>
                                                        <!-- Sky Rectangle (Tactical Cyan Blue) -->
                                                        <Rectangle Height="90" VerticalAlignment="Top" Fill="#0284C7"/>
                                                        <!-- Ground Rectangle (Earth Brown) -->
                                                        <Rectangle Height="90" VerticalAlignment="Bottom" Fill="#78350F"/>
                                                        <!-- White Horizon Line -->
                                                        <Rectangle Height="1.5" Width="80" Fill="#FFFFFF" VerticalAlignment="Center"/>

                                                        <!-- Pitch Ladder Bars -->
                                                        <StackPanel VerticalAlignment="Center" Spacing="9">
                                                            <!-- +20 deg -->
                                                            <Rectangle Width="26" Height="1" Fill="#FFFFFF" Opacity="0.8"/>
                                                            <!-- +10 deg -->
                                                            <Rectangle Width="38" Height="1.2" Fill="#FFFFFF" Opacity="0.9"/>
                                                            <!-- 0 deg (spacing gap) -->
                                                            <Grid Height="1.5"/>
                                                            <!-- -10 deg -->
                                                            <Rectangle Width="38" Height="1.2" Fill="#FFFFFF" Opacity="0.9"/>
                                                            <!-- -20 deg -->
                                                            <Rectangle Width="26" Height="1" Fill="#FFFFFF" Opacity="0.8"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>

                                                <!-- Outer Fixed Bank Angle Compass Ticks (Bezel markings) -->
                                                <Grid IsHitTestVisible="False">
                                                    <!-- Top Zero Roll Index (Amber Pointer) -->
                                                    <Polygon Points="41,2 38,7 44,7" Fill="#FACC15" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                    <!-- 30 deg ticks -->
                                                    <Rectangle Width="1" Height="4" Fill="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0">
                                                        <Rectangle.RenderTransform>
                                                            <RotateTransform Angle="30" CenterX="0.5" CenterY="39"/>
                                                        </Rectangle.RenderTransform>
                                                    </Rectangle>
                                                    <Rectangle Width="1" Height="4" Fill="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0">
                                                        <Rectangle.RenderTransform>
                                                            <RotateTransform Angle="-30" CenterX="0.5" CenterY="39"/>
                                                        </Rectangle.RenderTransform>
                                                    </Rectangle>
                                                    <!-- 45 deg ticks -->
                                                    <Rectangle Width="1.5" Height="5" Fill="#F8FAFC" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0">
                                                        <Rectangle.RenderTransform>
                                                            <RotateTransform Angle="45" CenterX="0.75" CenterY="39"/>
                                                        </Rectangle.RenderTransform>
                                                    </Rectangle>
                                                    <Rectangle Width="1.5" Height="5" Fill="#F8FAFC" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0">
                                                        <Rectangle.RenderTransform>
                                                            <RotateTransform Angle="-45" CenterX="0.75" CenterY="39"/>
                                                        </Rectangle.RenderTransform>
                                                    </Rectangle>
                                                </Grid>

                                                <!-- Fixed Center Aircraft Reticle / Boresight (High-Vis Amber Neon) -->
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <!-- Left Wing Bar -->
                                                    <Rectangle Width="18" Height="2.5" Fill="#FACC15" HorizontalAlignment="Left" Margin="0,0,16,0"/>
                                                    <!-- Right Wing Bar -->
                                                    <Rectangle Width="18" Height="2.5" Fill="#FACC15" HorizontalAlignment="Right" Margin="16,0,0,0"/>
                                                    <!-- Center Boresight Dot -->
                                                    <Ellipse Width="5" Height="5" Fill="#FACC15" Stroke="#000000" StrokeThickness="0.8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- Tactical Telemetry Status Pill -->
                                        <Border Background="#EE091122" CornerRadius="6" BorderBrush="#4038BDF8" BorderThickness="1" Padding="6,2" HorizontalAlignment="Center">
                                            <StackPanel Spacing="1">
                                                <TextBlock x:Name="ImuLabelText" Text="P -3.8° · R +4.2° · Y 092°" Foreground="#F8FAFC" FontSize="8" FontWeight="Bold" FontFamily="Consolas, monospace" HorizontalAlignment="Center"/>
                                                <TextBlock Text="ATTITUDE: AIRBORNE" FontSize="6.5" Foreground="#38BDF8" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Drop zone visual highlight when dragging a file over video -->
                                    <Border x:Name="VideoDropOverlay" Background="#E6022C22" BorderBrush="#10B981" BorderThickness="2" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                            <FontIcon Glyph="&#xE898;" FontSize="38" Foreground="#34D399"/>
                                            <TextBlock Text="LEPASKAN FILE VIDIO DI SINI" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Simulasi penerbangan, waypoint, dan telemetri akan disinkronkan otomatis!" FontSize="11" Foreground="#A7F3D0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- === Right side: Map + Detections stacked === -->
                            <Grid Grid.Column="1" RowSpacing="8" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="125"/>
                                    <RowDefinition Height="125"/>
                                </Grid.RowDefinitions>

                                <!-- Live Map -->
                                <Border Grid.Row="0" BorderBrush="#D1E7D5" BorderThickness="1" CornerRadius="10" Padding="8,7,8,7" Background="#FCFFFC">
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Live Aerial Map · Subang" FontSize="11" FontWeight="SemiBold" Foreground="#4F6B5C"/>
                                            <Border Grid.Column="1" Style="{StaticResource PillInfoStyle}" Padding="6,2">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE707;" FontSize="9" Foreground="#1D4ED8"/>
                                                    <TextBlock x:Name="HeadingPillText" Text="HDG 0°" FontSize="10" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <Border Height="88" CornerRadius="6" BorderBrush="#CAE3D1" BorderThickness="1" Background="#EAF4EC">
                                            <controls:SkiaMapControl x:Name="DashboardMapControl"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Live Detections list -->
                                <Border Grid.Row="1" BorderBrush="#D1E7D5" BorderThickness="1" CornerRadius="10" Padding="8,7,8,5" Background="#FCFFFC">
                                    <StackPanel Spacing="3">
                                        <TextBlock x:Name="DetectionsListTitle" Text="Live Detections · 4 Kelas PDP (15 objek)" FontSize="11" FontWeight="SemiBold" Foreground="#4F6B5C"/>
                                        <ScrollViewer Height="92" VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="DetectionsListStack" Spacing="2">
                                                <TextBlock x:Name="DetectionsEmptyText" Text="No detections above threshold." FontSize="11" Foreground="#94A3B8"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- === Recommendations + Export Card (full width) === -->
                <!-- Hidden controls — kept for code-behind compatibility -->
                <StackPanel Visibility="Collapsed">
                    <ToggleSwitch x:Name="YoloToggleSwitch" IsOn="False" Toggled="YoloToggle_Toggled"/>
                    <ToggleSwitch x:Name="VegToggleSwitch" IsOn="False" Toggled="VegToggle_Toggled"/>
                    <ToggleSwitch x:Name="ImuToggleSwitch" IsOn="False" Toggled="ImuToggle_Toggled"/>
                    <Slider x:Name="ConfThresholdSlider" Minimum="10" Maximum="95" Value="40" ValueChanged="ConfThresholdSlider_ValueChanged"/>
                    <TextBlock x:Name="ConfThresholdValue" Text="40%"/>
                </StackPanel>

                <!-- Action Recommendations + Export -->
                <Border Style="{StaticResource HarvestCardStyle}">
                    <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
