<Page
    x:Class="HarvestmoonGCS.Views.MissionPlannerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:HarvestmoonGCS.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource BackgroundBrush}">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{ThemeResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{ThemeResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource PrimaryBrush}"/>
        </Style>
    </Page.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Mission Actions Bar -->
        <Border Grid.Row="0" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10" Canvas.ZIndex="50">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Perencanaan Misi" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource ForegroundBrush}" VerticalAlignment="Center"/>
                    <Border Background="#1410B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="999" Padding="6,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center"/>
                            <TextBlock Text="WGS 84" Foreground="#34D399" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Click="SwitchToMapPage_Click" Style="{StaticResource OutlineButtonStyle}" Padding="8,4" ToolTipService.ToolTip="Buka Peta Lahan">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE81D;" FontSize="11"/>
                            <TextBlock Text="Peta Lahan" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                        <Button x:Name="DemoMissionButton" Click="LoadDemoMission_Click" Style="{StaticResource OutlineButtonStyle}" ToolTipService.ToolTip="Muat skenario penerbangan riset PDP" Padding="8,5">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE81E;" FontSize="11"/>
                                <TextBlock Text="Scenario" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddWaypointButton" Click="AddWaypointButton_Click" Style="{StaticResource OutlineButtonStyle}" ToolTipService.ToolTip="Tambah titik waypoint baru" Padding="8,5">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE710;" FontSize="11"/>
                                <TextBlock Text="Add WP" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DownloadMissionButton" Click="DownloadMissionButton_Click" Style="{StaticResource OutlineButtonStyle}" ToolTipService.ToolTip="Unduh misi aktif dari drone" Padding="8,5">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE896;" FontSize="11"/>
                                <TextBlock Text="Read UAV" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ClearWaypointButton" Click="ClearWaypointButton_Click" Style="{StaticResource OutlineButtonStyle}" ToolTipService.ToolTip="Hapus semua titik waypoint" Padding="8,5">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE74D;" FontSize="11"/>
                                <TextBlock Text="Clear All" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ImportMissionButton" Click="ImportMissionButton_Click" Style="{StaticResource OutlineButtonStyle}" ToolTipService.ToolTip="Import file .waypoints / .wpl" Padding="8,5">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE8E5;" FontSize="11"/>
                                <TextBlock Text="Import" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExportMissionButton" Click="ExportMissionButton_Click" Style="{StaticResource OutlineButtonStyle}" ToolTipService.ToolTip="Export file .waypoints / .wpl" Padding="8,5">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE74E;" FontSize="11"/>
                                <TextBlock Text="Export" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="UploadMissionButton" Click="UploadMissionButton_Click" Style="{StaticResource PrimaryButtonStyle}" ToolTipService.ToolTip="Kirim misi penerbangan ke drone" Padding="10,5">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE724;" FontSize="11"/>
                                <TextBlock Text="Write UAV" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Full Viewport Map with Floating Overlays -->
        <Grid Grid.Row="1">
            <controls:SkiaMapControl x:Name="MissionMapControl"
                                     DoubleTapped="MissionMapControl_DoubleTapped" />

            <!-- Floating Top Controls Bar (Map Provider, Layers, Geofence) -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="16,14,0,0"
                    Background="{ThemeResource CardBrush95}"
                    BorderBrush="{ThemeResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,6"
                    Canvas.ZIndex="300">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Map:" VerticalAlignment="Center" Foreground="{ThemeResource MutedForegroundBrush}" FontSize="11" FontWeight="SemiBold"/>
                    <ComboBox x:Name="MapProviderComboBox" Width="140" SelectionChanged="MapProviderComboBox_SelectionChanged" SelectedIndex="0">
                        <ComboBoxItem Content="Google Map"/>
                        <ComboBoxItem Content="Google Satellite"/>
                        <ComboBoxItem Content="Google Hybrid"/>
                        <ComboBoxItem Content="Google Terrain"/>
                        <ComboBoxItem Content="OpenStreetMap"/>
                        <ComboBoxItem Content="ArcGIS Topographic"/>
                        <ComboBoxItem Content="ArcGIS Imagery"/>
                        <ComboBoxItem Content="ArcGIS StreetMap"/>
                    </ComboBox>

                    <ToggleButton x:Name="ToggleIrrigationBtn" IsChecked="True" Click="ToggleIrrigationBtn_Click" FontSize="11" Padding="7,4" CornerRadius="5" ToolTipService.ToolTip="Tampilkan/sembunyikan poligon petak sawah tematik">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE809;" FontSize="11"/>
                            <TextBlock Text="Field Plots" FontSize="11"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="ToggleSensorsBtn" IsChecked="True" Click="ToggleSensorsBtn_Click" FontSize="11" Padding="7,4" CornerRadius="5" ToolTipService.ToolTip="Tampilkan/sembunyikan sensor in-situ tanah">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE7C1;" FontSize="11"/>
                            <TextBlock Text="Soil Probes" FontSize="11"/>
                        </StackPanel>
                    </ToggleButton>

                    <Border Width="1" Background="{ThemeResource BorderBrush}" Margin="4,2"/>

                    <!-- Geofence Quick Bar -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <CheckBox x:Name="GeofenceEnableCheckBox" Content="Geofence" IsChecked="False" Click="GeofenceEnableCheckBox_Click" VerticalAlignment="Center" FontSize="11"/>
                        <Slider x:Name="GeofenceRadiusSlider" Width="75" Minimum="100" Maximum="1000" Value="650" ValueChanged="GeofenceRadiusSlider_ValueChanged" IsEnabled="False" VerticalAlignment="Center"/>
                        <TextBlock x:Name="GeofenceLabel" Text="650 m" VerticalAlignment="Center" Foreground="{ThemeResource ForegroundBrush}" FontWeight="SemiBold" FontSize="11"/>
                        <Button x:Name="SendGeofenceButton" Content="Upload Fence" FontSize="10" Padding="6,4" CornerRadius="4"
                                Background="{ThemeResource SecondaryBrush}" Foreground="{ThemeResource ForegroundBrush}"
                                ToolTipService.ToolTip="Kirim batas aman terbang ke wahana"
                                Click="SendGeofenceButton_Click" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Floating Waypoints Drawer Panel (Right Side) -->
            <Border x:Name="WaypointDrawerPanel"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Margin="0,14,16,16"
                    Width="340"
                    Background="{ThemeResource CardBrush95}"
                    BorderBrush="{ThemeResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Canvas.ZIndex="350">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Rencana Misi Penerbangan" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource ForegroundBrush}"/>
                            <TextBlock Text="Urutan Titik Eksekusi Autopilot" FontSize="10" Foreground="{ThemeResource MutedForegroundBrush}"/>
                        </StackPanel>
                    </Grid>

                    <ListView x:Name="WaypointListView" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Background="#1F2E7D32" BorderBrush="#4CAF50" BorderThickness="1" CornerRadius="999" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Sequence}" Foreground="{ThemeResource ForegroundBrush}" FontWeight="SemiBold"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Coordinates}" Foreground="{ThemeResource ForegroundBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding AltitudeText}" Foreground="{ThemeResource MutedForegroundBrush}" FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                        <Button Tag="{Binding Sequence}"
                                                Click="EditWaypointButton_Click"
                                                Style="{StaticResource OutlineButtonStyle}"
                                                ToolTipService.ToolTip="Edit Waypoint Altitude &amp; Coords"
                                                Padding="6,4">
                                            <FontIcon Glyph="&#xE70F;" FontSize="11"/>
                                        </Button>
                                        <Button Tag="{Binding Sequence}"
                                                Click="RemoveWaypointButton_Click"
                                                Style="{StaticResource OutlineButtonStyle}"
                                                ToolTipService.ToolTip="Remove Waypoint"
                                                Padding="6,4">
                                            <FontIcon Glyph="&#xE711;" FontSize="11"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Grid.Row="2" Margin="0,10,0,0" Padding="10" CornerRadius="8" Background="#151A2530" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                        <TextBlock x:Name="WaypointSummaryText" Text="0 waypoints" Foreground="{ThemeResource ForegroundBrush}" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
