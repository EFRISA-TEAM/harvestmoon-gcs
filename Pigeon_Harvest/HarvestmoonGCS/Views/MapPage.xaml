                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="GeofenceEnableCheckBox" Grid.Column="0" Content="Batas Geofence Aktif" IsChecked="False" Click="GeofenceEnableCheckBox_Click" FontSize="11" FontWeight="SemiBold"/>
