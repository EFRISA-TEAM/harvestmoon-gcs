<Page x:Class="HarvestmoonGCS.Views.MapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="using:HarvestmoonGCS.Views"
      xmlns:controls="using:HarvestmoonGCS.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="632" d:DesignWidth="1132" 
      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
      Background="{ThemeResource BackgroundBrush}">
    
    <Page.Resources>
        <!-- Pill Style Border -->
        <Style TargetType="Border" x:Key="PillBorder">
            <Setter Property="Background" Value="{ThemeResource BackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        
        <!-- Settings Bar Style -->
        <Style TargetType="Border" x:Key="SettingsBar">
            <Setter Property="Background" Value="{ThemeResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        
        <!-- Icon Button Style -->
        <Style TargetType="Button" x:Key="IconButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
        </Style>
        
        <!-- Control Panel Style -->
        <Style TargetType="Border" x:Key="ControlPanel">
            <Setter Property="Background" Value="{ThemeResource CardBrush80}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Page.Resources>

    <Grid x:Name="MapRootGrid" Background="{ThemeResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Settings Bar (Top) -->
        <Border Grid.Row="0" Style="{StaticResource SettingsBar}" Canvas.ZIndex="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Disabled">
                <StackPanel x:Name="MapToolbar" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Map Style Selector -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Map Style:" Foreground="{ThemeResource MutedForegroundBrush}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="11"/>
                        <ComboBox x:Name="cb_map_type" 
                                  SelectionChanged="ChooseMap" 
                                  SelectedIndex="1" 
                                  MinWidth="135"
                                  ToolTipService.ToolTip="Pilih penyedia peta">
                            <ComboBoxItem Content="Google Map"/>
                            <ComboBoxItem Content="Google Satellite"/>
                            <ComboBoxItem Content="Google Hybrid"/>
                            <ComboBoxItem Content="Google Terrain"/>
                            <ComboBoxItem Content="OpenStreetMap"/>
                            <ComboBoxItem Content="ArcGIS Imagery"/>
                            <ComboBoxItem Content="ArcGIS Topographic"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- WP RADIUS -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="WP Radius (m):" Foreground="{ThemeResource MutedForegroundBrush}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox x:Name="tb_wp_radius" Text="2" Width="42" TextAlignment="Center" TextChanged="WpRadius_TextChanged"/>
                    </StackPanel>

                    <!-- Tap Waypoint Mode Toggle -->
                    <ToggleButton x:Name="btn_single_tap_wp" 
                                  Click="ToggleSingleTapWP_Click"
                                  Padding="8,4"
                                  ToolTipService.ToolTip="Mode ketuk tunggal peta untuk menambah waypoint">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE7C1;" FontSize="12"/>
                            <TextBlock Text="Tap Waypoint" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Clear Waypoints -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Clear" Foreground="{ThemeResource MutedForegroundBrush}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="11"/>
                        <Button x:Name="btn_clear_waypoints" Click="ResetMarkers_Click" Padding="6,4" Background="Transparent" BorderThickness="1" BorderBrush="{ThemeResource BorderBrush}" ToolTipService.ToolTip="Hapus semua titik waypoint &amp; geofence">
                            <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                        </Button>
                    </StackPanel>

                    <!-- Total Distance -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Total Distance:" Foreground="{ThemeResource MutedForegroundBrush}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="11"/>
                        <TextBlock x:Name="tb_total_distance" Text="0.00 Km" Foreground="{ThemeResource ForegroundBrush}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>

                    <!-- Follow Vehicle -->
                    <Border x:Name="follow_wahana_border"
                            Background="{ThemeResource CardBrush}"
                            BorderBrush="{ThemeResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="1">
                        <Button Click="FollowVehicle_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8,4"
                                ToolTipService.ToolTip="Follow UAV — pusatkan peta ke wahana">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7C3;" FontSize="12" Foreground="{ThemeResource PrimaryBrush}"/>
                                <TextBlock Text="Follow UAV" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Skenario Lahan PDP -->
                    <Button x:Name="btn_demo_irrigation" Click="LoadDemoIrrigation_Click" Style="{StaticResource ModernButtonStyle}"
                            ToolTipService.ToolTip="Muat skenario penerbangan riset PDP dan pemetaan lahan sawah"
                            Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE81E;" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Field Scenario" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Grid Survey (Fotogrametri Pertanian) -->
                    <Button x:Name="btn_grid_survey" Click="GenerateSurveyGrid_Click" Style="{StaticResource ModernButtonStyle}"
                            ToolTipService.ToolTip="Buat jalur fotogrametri survei udara (transek bolak-balik) otomatis untuk pemetaan lahan"
                            Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE80A;" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Survey Grid" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Flight Telemetry Toggle Button -->
                    <ToggleButton x:Name="btn_toggle_flight_telemetry" Click="ToggleFlightTelemetry_Click"
                                  IsChecked="True"
                                  Padding="8,4"
                                  ToolTipService.ToolTip="Tampilkan / Sembunyikan Overlay Flight Telemetry UAV (Altitude, Speed, Attitude, Battery, GPS RTK)">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE709;" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center"/>
                            <TextBlock Text="Flight Telemetry" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Telemetri Tematik Lahan Toggle -->
                    <ToggleButton x:Name="btn_toggle_pdp_monitor" Click="TogglePDPMonitor_Click"
                                  IsChecked="True"
                                  Padding="8,4"
                                  ToolTipService.ToolTip="Buka Panel Telemetri Tematik Lahan &amp; Sensor In-situ (4 Sektor &amp; In-situ Probes)">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE9D2;" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Field &amp; Soil Telemetry" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Mission Planner Navigation Switch -->
                    <Button Click="OpenMissionPlanner_Click" Style="{StaticResource ModernButtonStyle}"
                            ToolTipService.ToolTip="Buka Halaman Perencanaan Misi Lengkap"
                            Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE81E;" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Mission Planner" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                </ScrollViewer>

                <!-- Right side: Eagle GCS Geofence Status Badge -->
                <Border x:Name="geofence_status_border" 
                        Grid.Column="1"
                        Style="{StaticResource PillBorder}" 
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0"
                        Tapped="ToggleGeofencePanel_Click"
                        ToolTipService.ToolTip="Buka / Tutup Pengaturan Geofence Eagle">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="geofence_status_dot" Width="8" Height="8" Fill="{ThemeResource MutedForegroundBrush}"/>
                        <TextBlock x:Name="geofence_status_text" 
                                   Text="Geofence Inactive" 
                                   Foreground="{ThemeResource ForegroundBrush}" 
                                   FontWeight="Bold" 
                                   FontSize="11" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Map Area -->
        <Grid Grid.Row="1">
            <controls:SkiaMapControl x:Name="mapControl" 
                                     DoubleTapped="MapControl_DoubleTapped"
                                     Tapped="MapControl_Tapped"/>

            <!-- Scientific Cartographic & Geodetic HUD (Top-Left) -->
            <Border x:Name="cartographic_hud"
                    Background="{ThemeResource CardBrush80}"
                    BorderBrush="{ThemeResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="16,14,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Canvas.ZIndex="350">
                <StackPanel Spacing="5">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Background="#220EA5E9" BorderBrush="#0EA5E9" BorderThickness="1" CornerRadius="4" Padding="5,1">
                            <TextBlock Text="WGS 84 / EPSG:4326" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Border>
                        <Border Background="#2210B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="5,1">
                            <TextBlock Text="UTM 48S" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                        </Border>
                        <TextBlock Text="▲ N" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource ForegroundBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Center:" FontSize="10" Foreground="{ThemeResource MutedForegroundBrush}"/>
                        <TextBlock x:Name="hud_center_coord" Text="-6.243610° S, 107.365560° E" FontSize="10" FontFamily="Consolas, monospace" FontWeight="SemiBold" Foreground="{ThemeResource ForegroundBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Alt:" FontSize="10" Foreground="{ThemeResource MutedForegroundBrush}"/>
                            <TextBlock x:Name="hud_flight_alt" Text="50.0 m AGL" FontSize="10" FontWeight="SemiBold" Foreground="#34D399"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="GSD:" FontSize="10" Foreground="{ThemeResource MutedForegroundBrush}"/>
                            <TextBlock x:Name="hud_gsd_val" Text="1.82 cm/px" FontSize="10" FontWeight="SemiBold" Foreground="#F59E0B"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Zoom:" FontSize="10" Foreground="{ThemeResource MutedForegroundBrush}"/>
                            <TextBlock x:Name="hud_zoom_val" Text="Z16" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource ForegroundBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Graphic Scale Bar -->
                    <Grid Margin="0,2,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Height="4" BorderBrush="{ThemeResource ForegroundBrush}" BorderThickness="1" CornerRadius="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{ThemeResource ForegroundBrush}"/>
                                <Border Grid.Column="1" Background="Transparent"/>
                                <Border Grid.Column="2" Background="{ThemeResource ForegroundBrush}"/>
                                <Border Grid.Column="3" Background="Transparent"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" Margin="0,2,0,0">
                            <TextBlock Text="0m" FontSize="8" HorizontalAlignment="Left" Foreground="{ThemeResource MutedForegroundBrush}"/>
                            <TextBlock Text="50m" FontSize="8" HorizontalAlignment="Center" Foreground="{ThemeResource MutedForegroundBrush}"/>
                            <TextBlock Text="100m" FontSize="8" HorizontalAlignment="Right" Foreground="{ThemeResource MutedForegroundBrush}"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Tactical UAV Flight Telemetry Floating HUD Panel (Left, below Cartographic HUD) -->
            <Border x:Name="flight_telemetry_hud_panel"
                    Background="{ThemeResource CardBrush95}"
                    BorderBrush="{ThemeResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,10"
                    Margin="16,112,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Width="340"
                    Canvas.ZIndex="380">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header with Status Badge & Close/Hide -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Background="#2210B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txt_map_telemetry_state" Text="AIRBORNE" FontSize="9.5" FontWeight="Bold" Foreground="#10B981"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="UAV Flight Telemetry" FontSize="11.5" FontWeight="Bold" Foreground="{ThemeResource ForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Click="ToggleFlightTelemetry_Click" Style="{StaticResource IconButton}" Width="24" Height="24" Padding="0" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE711;" FontSize="10"/>
                        </Button>
                    </Grid>

                    <!-- Row 1: Tactical Mini Attitude Reticle & Readout -->
                    <Border Grid.Row="1" Background="#15000000" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Mini Reticle icon -->
                            <Border Grid.Column="0" Width="36" Height="36" Background="#20000000" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="18" Margin="0,0,8,0">
                                <Canvas x:Name="canvas_map_mini_attitude" Width="36" Height="36">
                                    <!-- Artificial horizon line -->
                                    <Line x:Name="line_mini_horizon" X1="4" Y1="18" X2="32" Y2="18" Stroke="#38BDF8" StrokeThickness="1.5"/>
                                    <!-- Reticle pip -->
                                    <Ellipse Canvas.Left="15" Canvas.Top="15" Width="6" Height="6" Fill="#F59E0B"/>
                                </Canvas>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="txt_map_uav_attitude" Text="P -4.0° · R +12.5° · Y 140° (SE)" FontSize="11" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#38BDF8"/>
                                <TextBlock x:Name="txt_map_uav_modethr" Text="MODE: AUTO · THROTTLE 68% · ARMED" FontSize="9.5" Foreground="{ThemeResource MutedForegroundBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 2: 4-Column Primary Flight Instruments Grid -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- ALTITUDE -->
                        <Border Grid.Column="0" Background="{ThemeResource BackgroundBrush}" CornerRadius="5" Padding="6,4" Margin="0,0,3,0">
                            <StackPanel Spacing="1">
                                <TextBlock Text="ALTITUDE" FontSize="8.5" FontWeight="SemiBold" Foreground="{ThemeResource MutedForegroundBrush}"/>
                                <TextBlock x:Name="txt_map_uav_alt" Text="49.8 m" FontSize="12" FontWeight="Bold" Foreground="#34D399"/>
                                <TextBlock Text="AGL (50m ref)" FontSize="8" Foreground="{ThemeResource MutedForegroundBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- GROUND SPEED -->
                        <Border Grid.Column="1" Background="{ThemeResource BackgroundBrush}" CornerRadius="5" Padding="6,4" Margin="2,0,2,0">
                            <StackPanel Spacing="1">
                                <TextBlock Text="SPEED" FontSize="8.5" FontWeight="SemiBold" Foreground="{ThemeResource MutedForegroundBrush}"/>
                                <TextBlock x:Name="txt_map_uav_spd" Text="8.4 m/s" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                <TextBlock Text="30.2 km/h" FontSize="8" Foreground="{ThemeResource MutedForegroundBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- VERTICAL SPEED -->
                        <Border Grid.Column="2" Background="{ThemeResource BackgroundBrush}" CornerRadius="5" Padding="6,4" Margin="2,0,2,0">
                            <StackPanel Spacing="1">
                                <TextBlock Text="V. SPEED" FontSize="8.5" FontWeight="SemiBold" Foreground="{ThemeResource MutedForegroundBrush}"/>
                                <TextBlock x:Name="txt_map_uav_vspd" Text="+0.1 m/s" FontSize="12" FontWeight="Bold" Foreground="#F59E0B"/>
                                <TextBlock Text="Climb rate" FontSize="8" Foreground="{ThemeResource MutedForegroundBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- BATTERY -->
                        <Border Grid.Column="3" Background="{ThemeResource BackgroundBrush}" CornerRadius="5" Padding="6,4" Margin="3,0,0,0">
                            <StackPanel Spacing="1">
                                <TextBlock Text="BATTERY" FontSize="8.5" FontWeight="SemiBold" Foreground="{ThemeResource MutedForegroundBrush}"/>
                                <TextBlock x:Name="txt_map_uav_batt" Text="95%" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                                <TextBlock x:Name="txt_map_uav_volt" Text="12.5V 3S" FontSize="8" Foreground="{ThemeResource MutedForegroundBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 3: Navigation, GNSS RTK & Sensors -->
                    <Border Grid.Row="3" Background="{ThemeResource BackgroundBrush}" CornerRadius="5" Padding="8,5" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="GNSS FIX &amp; SATELLITES" FontSize="8.5" FontWeight="SemiBold" Foreground="{ThemeResource MutedForegroundBrush}"/>
                                <TextBlock x:Name="txt_map_uav_gps" Text="RTK Fixed · 16 Sats" FontSize="10.5" FontWeight="Bold" Foreground="#10B981"/>
                                <TextBlock x:Name="txt_map_uav_hdop" Text="HDOP: 0.4 · DGPS Valid" FontSize="8.5" Foreground="{ThemeResource MutedForegroundBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="TRANSECT &amp; DISTANCE" FontSize="8.5" FontWeight="SemiBold" Foreground="{ThemeResource MutedForegroundBrush}"/>
                                <TextBlock x:Name="txt_map_uav_dist" Text="Dist: 480 m / 1.85 km" FontSize="10.5" FontWeight="Bold" Foreground="{ThemeResource ForegroundBrush}"/>
                                <TextBlock x:Name="txt_map_uav_eta" Text="ETA WP-End: 05:42" FontSize="8.5" Foreground="{ThemeResource MutedForegroundBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 4: Waypoint Leg Mission Progress -->
                    <StackPanel Grid.Row="4" Spacing="3">
                        <Grid>
                            <TextBlock x:Name="txt_map_uav_wp_leg" Text="WAYPOINT 4 → 5 (Sektor B Transek 2)" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource ForegroundBrush}"/>
                            <TextBlock x:Name="txt_map_uav_wp_pct" Text="Progress: 35%" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#38BDF8"/>
                        </Grid>
                        <ProgressBar x:Name="pb_map_uav_wp" Value="35" Maximum="100" Height="4" Foreground="#38BDF8" Background="#33000000"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PDP Thematic Zoning & Telemetry Floating Panel -->
            <Border x:Name="pdp_monitor_panel"
                    Background="{ThemeResource CardBrush95}"
                    BorderBrush="{ThemeResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="0"
                    Margin="0,14,56,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    MaxWidth="390"
                    MaxHeight="600"
                    Visibility="Visible"
                    Canvas.ZIndex="450">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header bar -->
                    <Grid Grid.Row="0" Padding="14,10,12,10" Background="{ThemeResource BackgroundBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Telemetri Lahan &amp; Irigasi Presisi" FontSize="12.5" FontWeight="Bold" Foreground="{ThemeResource ForegroundBrush}"/>
                            <TextBlock Text="Pabuaran, Subang · Survei UAV 50 m AGL · Sensor RS-485" FontSize="10" Foreground="{ThemeResource MutedForegroundBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Click="TogglePDPMonitor_Click" Style="{StaticResource IconButton}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE711;" FontSize="12"/>
                        </Button>
                    </Grid>
                    <Border Grid.Row="0" Height="1" Background="{ThemeResource BorderBrush}" VerticalAlignment="Bottom"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="14,12" Spacing="10">

                            <!-- Alert status -->
                            <Border Background="#1AE04848" BorderBrush="#E04848" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="IRIGASI DARURAT: BLOK A1 &amp; B2" FontSize="11" FontWeight="Bold" Foreground="#EF4444"/>
                                        <TextBlock Text="Debit rekomendasi: 1.8 L/s dari saluran tersier barat" FontSize="10" Foreground="{ThemeResource MutedForegroundBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#EF4444" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="PRIORITAS 1" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Water budget KPIs -->
                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Defisit Air" FontSize="10" Foreground="{ThemeResource MutedForegroundBrush}"/>
                                    <TextBlock Text="10,750 L" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource ForegroundBrush}"/>
                                    <TextBlock Text="10.75 m³" FontSize="9.5" Foreground="{ThemeResource MutedForegroundBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
