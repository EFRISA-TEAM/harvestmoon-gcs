                                        <TextBlock x:Name="txt_probe_p03_vals" Text="38.2% · 29.4°C" FontSize="10.5" Foreground="#EAB308" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="txt_probe_p03_diag" Text="4.2 V · −75 dBm" FontSize="9" Foreground="{ThemeResource MutedForegroundBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="P-04" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource MutedForegroundBrush}" Width="28"/>
                                    <StackPanel Spacing="0">
                                        <TextBlock x:Name="txt_probe_p04_vals" Text="68.1% · 27.6°C" FontSize="10.5" Foreground="#10B981" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="txt_probe_p04_diag" Text="4.2 V · −71 dBm" FontSize="9" Foreground="{ThemeResource MutedForegroundBrush}"/>
                                    </StackPanel>
