                                    <StackPanel Spacing="0">
                                        <TextBlock x:Name="txt_probe_p02_vals" Text="23.4% · 31.0°C" FontSize="10.5" Foreground="#F59E0B" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="txt_probe_p02_diag" Text="4.0 V · −82 dBm" FontSize="9" Foreground="{ThemeResource MutedForegroundBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

