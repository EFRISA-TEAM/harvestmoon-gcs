                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="Agreement" FontSize="9.5" Foreground="{ThemeResource MutedForegroundBrush}"/>
                                    <TextBlock Text="92.5%" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource ForegroundBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="1">
                                    <TextBlock Text="R² Korelasi" FontSize="9.5" Foreground="{ThemeResource MutedForegroundBrush}"/>
                                    <TextBlock Text="0.914" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource PrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="1">
                                    <TextBlock Text="RMSE" FontSize="9.5" Foreground="{ThemeResource MutedForegroundBrush}"/>
