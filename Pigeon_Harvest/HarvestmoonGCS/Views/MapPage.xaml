                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Bottom Overlay: Markers Button -->
            <Button x:Name="wp_dock_btn" 
                    Style="{StaticResource ModernButtonStyle}"
                    Click="ToggleWPDock"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Left"
                    Margin="16"
                    Canvas.ZIndex="400">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE81E;" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="tb_markers_count" Text="Mission Plan: 0 ▲" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Waypoint List Panel (Expanded Aeronautical Mission Table) -->
            <Border x:Name="wp_list_panel"
                    Background="{ThemeResource CardBrush80}"
                    BorderBrush="{ThemeResource BorderBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Left"
                    Margin="16,0,16,80"
                    MaxHeight="320"
                    MinWidth="640"
                    MaxWidth="840"
                    CornerRadius="8"
                    Padding="12"
                    Visibility="Collapsed"
                    Canvas.ZIndex="400">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Top Action & Statistics Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Mission Actions -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="btn_send_mission"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Click="SendWaypointCommand"
                                    ToolTipService.ToolTip="Kirim misi ke autopilot via MAVLink"
                                    Padding="10,5">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE724;" FontSize="12"/>
                                    <TextBlock Text="WRITE UAV" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btn_start_mission"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Click="DownloadMission_Click"
                                    ToolTipService.ToolTip="Download misi aktif dari UAV"
                                    Padding="10,5">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE896;" FontSize="12"/>
                                    <TextBlock Text="READ UAV" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            <Button Click="ExportCsv_Click"
                                    Style="{StaticResource ModernButtonStyle}"
                                    ToolTipService.ToolTip="Ekspor tabel koordinat misi ke CSV untuk naskah publikasi"
                                    Padding="8,5">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE74E;" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="CSV" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Mission Metrics Banner -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Dist:" FontSize="10" Foreground="{ThemeResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="tb_dock_total_distance" Text="0.00 km" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="EET:" FontSize="10" Foreground="{ThemeResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="tb_dock_eet" Text="00:00" FontSize="11" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Area:" FontSize="10" Foreground="{ThemeResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="tb_dock_area" Text="2.77 ha" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- File / Edit Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                            <Button x:Name="Undo" Style="{StaticResource IconButton}" Click="Undo_Click" ToolTipService.ToolTip="Undo">
                                <FontIcon Glyph="&#xE7A7;" FontSize="13"/>
                            </Button>
                            <Button x:Name="Redo" Style="{StaticResource IconButton}" Click="Redo_Click" ToolTipService.ToolTip="Redo">
                                <FontIcon Glyph="&#xE7A6;" FontSize="13"/>
                            </Button>
                            <Button x:Name="Import" Style="{StaticResource IconButton}" Click="ImportWaypoints_Click" ToolTipService.ToolTip="Import Format QGC / WPL">
                                <FontIcon Glyph="&#xE8E5;" FontSize="13"/>
                            </Button>
                            <Button x:Name="Export" Style="{StaticResource IconButton}" Click="ExportWaypoints_Click" ToolTipService.ToolTip="Export Format QGC / WPL">
                                <FontIcon Glyph="&#xE74E;" FontSize="13"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Table Column Header -->
                    <Border Grid.Row="1" Background="{ThemeResource BackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="65"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="WP#" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource MutedForegroundBrush}"/>
                            <TextBlock Grid.Column="1" Text="COMMAND" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource MutedForegroundBrush}"/>
                            <TextBlock Grid.Column="2" Text="LATITUDE" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource MutedForegroundBrush}"/>
                            <TextBlock Grid.Column="3" Text="LONGITUDE" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource MutedForegroundBrush}"/>
                            <TextBlock Grid.Column="4" Text="ALT AGL" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource MutedForegroundBrush}"/>
                            <TextBlock Grid.Column="5" Text="SPEED" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource MutedForegroundBrush}"/>
                            <TextBlock Grid.Column="6" Text="ACTION" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource MutedForegroundBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Waypoint List Scroll -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="wp_dock_stack" Spacing="4">
                            <TextBlock x:Name="wp_empty_message" 
                                       Text="Double-click pada peta atau gunakan 'Survey Grid' / 'Field Scenario' untuk merencanakan rute penerbangan." 
                                       Foreground="{ThemeResource MutedForegroundBrush}" 
                                       FontStyle="Italic" 
                                       FontSize="11"
                                       Margin="8"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Geofence Panel (Right Side) -->
            <Border x:Name="geofence_panel" 
                    Style="{StaticResource ControlPanel}"
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top" 
                    Margin="20"
                    MinWidth="300"
                    MaxWidth="340"
                    Visibility="Collapsed"
                    Canvas.ZIndex="500">
                <StackPanel Spacing="12">
                    <!-- Header -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⬡ GEOFENCE SETTINGS" 
                                       FontSize="13" 
                                       FontWeight="Bold" 
                                       Foreground="{ThemeResource ForegroundBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Click="ToggleGeofencePanel_Click" HorizontalAlignment="Right" Style="{StaticResource IconButton}">
                            <FontIcon Glyph="&#xE711;" FontSize="12"/>
                        </Button>
                    </Grid>
                    
                    <Border Height="1" Background="{ThemeResource BorderBrush}"/>

