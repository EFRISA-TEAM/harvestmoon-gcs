<UserControl x:Class="HarvestmoonGCS.Controls.VideoStreamControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="using:SkiaSharp.Views.Windows">
    
    <Grid>
        <!-- Background image (logo) - shown when not streaming -->
        <Image x:Name="BackgroundImage"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Visibility="Visible" />
        
        <!-- SkiaSharp canvas for video rendering -->
        <skia:SKXamlCanvas x:Name="VideoCanvas"
                          PaintSurface="OnPaintSurface"
                          Background="Transparent"
                          Visibility="Collapsed" />
        
        <!-- FPS counter (debug) -->
        <TextBlock x:Name="FpsCounter"
                  Text="FPS: 0"
                  Foreground="Yellow"
                  FontSize="12"
                  Margin="10"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Right"
                  Visibility="Collapsed" />

        <!-- Status overlay: shown via ShowStatus()/hidden via HideOverlay() for camera/stream feedback -->
        <Grid x:Name="StatusOverlay"
              Background="#B3000000"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressRing x:Name="StatusLoadingRing"
                              IsActive="False"
                              Width="32"
                              Height="32"
                              Foreground="White"
                              Visibility="Collapsed" />
                <TextBlock x:Name="StatusText"
                           Text=""
                           Foreground="White"
                           FontSize="14"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="320" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
